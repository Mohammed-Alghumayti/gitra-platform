# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.
subscription_id = "00000000-0000-0000-0000-000000000000"

location                  = "eastus"
vm_size                   = "Standard_D2s_v3"
runner_vm_size            = "Standard_B2s"
admin_username            = "azureuser"
admin_ssh_public_key_path = "~/.ssh/id_rsa.pub"

# GitLab URL: https://<dns_label>.<location>.cloudapp.azure.com — must be unique.
dns_label = "gitra-platform"

# Public by design. Optionally narrow admin SSH, e.g. ["203.0.113.10/32"]
admin_source_cidrs = ["0.0.0.0/0"]
user_source_cidrs  = ["0.0.0.0/0"]

repo_branch = "Testing"
